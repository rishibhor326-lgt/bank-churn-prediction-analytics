import joblib
import pandas as pd

# 1. Load trained pipeline
model_pipeline = joblib.load('churn_model.pkl')

# 2. Extract feature names from preprocessor
preprocessor = model_pipeline.named_steps['preprocessor']
classifier = model_pipeline.named_steps['classifier']

num_cols = preprocessor.transformers_[0][2]
cat_encoder = preprocessor.transformers_[1][1]
cat_cols = cat_encoder.get_feature_names_out(
    preprocessor.transformers_[1][2]
).tolist()

all_feature_names = num_cols + cat_cols

# 3. Extract and display feature importances
importances = pd.Series(
    classifier.feature_importances_, index=all_feature_names
).sort_values(ascending=False)

print('=== Top Churn Risk Drivers ===')
for feature, score in importances.items():
  print(f'{feature:<25}: {score:.2%}').venv/bin/python -m pip freeze > requirements.txt
